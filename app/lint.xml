<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- BouncyCastle ships a trust-everything TrustManager for its own TLS tooling. PDFBox uses BouncyCastle only for
         certificate-encrypted PDFs, and the app makes no TLS connections through it, so the class is never reached. -->
    <issue id="TrustAllX509TrustManager">
        <ignore regexp="bcpkix-jdk15to18" />
    </issue>
    <!-- The owner's version catalog (gradle/libs.versions.toml) covers :translate and :baselineprofile so far; :app's
         dependencies are still inline. Moving them is a mechanical follow-up (R10), not a defect. -->
    <issue id="UseTomlInstead" severity="ignore" />
</lint>
