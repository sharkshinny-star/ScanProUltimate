<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup stays off: documents are private and must not leave the device for a server.
  Device-to-device transfer (encrypted, phone to phone when setting up a new phone) is allowed, so
  the library and settings move with the user instead of being lost.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- QR history uses a device-bound Keystore key; the key cannot transfer to a new phone. -->
        <exclude domain="file" path="scan_history.json" />
        <!-- Unfinished scanner sessions belong to this phone; the cache is never transferred anyway. -->
        <exclude domain="file" path="pro_scanner_session/" />
        <!-- Edits waiting to run refer to this phone's queue; replaying them on another phone would surprise. -->
        <exclude domain="file" path="edit_journal/" />
    </device-transfer>
</data-extraction-rules>
