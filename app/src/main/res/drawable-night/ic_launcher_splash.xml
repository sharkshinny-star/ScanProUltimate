<?xml version="1.0" encoding="utf-8"?>
<!-- Animated launch-screen icon for Dark Theme (Android 12+): the launcher mark assembles itself in one second.
     Features the DarkBrand vibrant indigo/violet gradient (#4457E6 to #7D6CF2) and luminous mint scanline (#3DE3B2). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <!-- Background: Dark brand gradient with soft radial glow -->
            <path android:pathData="M0,0h108v108h-108z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="0"
                        android:startY="0"
                        android:endX="108"
                        android:endY="108"
                        android:startColor="#4457E6"
                        android:endColor="#7D6CF2" />
                </aapt:attr>
            </path>
            <path android:pathData="M0,0h108v108h-108z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="radial"
                        android:centerX="18"
                        android:centerY="14"
                        android:gradientRadius="70"
                        android:startColor="#33FFFFFF"
                        android:endColor="#00FFFFFF" />
                </aapt:attr>
            </path>

            <group
                android:name="sheet"
                android:pivotX="54"
                android:pivotY="55"
                android:scaleX="0.8"
                android:scaleY="0.8">
                <path
                    android:name="shadow"
                    android:fillColor="#000000"
                    android:fillAlpha="0"
                    android:pathData="M37,29h26l12,12v38.5a5,5 0 0,1 -5,5h-33a5,5 0 0,1 -5,-5v-45.5a5,5 0 0,1 5,-5z" />
                <path
                    android:name="paper"
                    android:fillColor="#F3F4FA"
                    android:fillAlpha="0"
                    android:pathData="M36,26h26l12,12v40a5,5 0 0,1 -5,5h-33a5,5 0 0,1 -5,-5v-47a5,5 0 0,1 5,-5z" />
                <path
                    android:name="fold"
                    android:fillColor="#B9C0FF"
                    android:fillAlpha="0"
                    android:pathData="M62,26v8a4,4 0 0,0 4,4h8z" />
                <path
                    android:name="text"
                    android:fillColor="#4457E6"
                    android:fillAlpha="0"
                    android:pathData="M43,44h15a2,2 0 0,1 0,4h-15a2,2 0 0,1 0,-4zM43,63h20a2,2 0 0,1 0,4h-20a2,2 0 0,1 0,-4z" />
            </group>

            <group
                android:name="scan"
                android:translateY="-24">
                <path
                    android:name="scanLine"
                    android:pathData="M24,55.5h60"
                    android:strokeAlpha="0"
                    android:strokeColor="#3DE3B2"
                    android:strokeLineCap="round"
                    android:strokeWidth="5" />
            </group>

            <group
                android:name="brackets"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="1.3"
                android:scaleY="1.3">
                <path
                    android:name="bracketPaths"
                    android:pathData="M32,20h-8a4,4 0 0,0 -4,4v8M76,20h8a4,4 0 0,1 4,4v8M32,88h-8a4,4 0 0,1 -4,-4v-8M76,88h8a4,4 0 0,0 4,-4v-8"
                    android:strokeAlpha="0"
                    android:strokeColor="#FFFFFF"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:strokeWidth="4.5" />
            </group>
        </vector>
    </aapt:attr>

    <!-- 0–280 ms: brackets snap in -->
    <target android:name="brackets">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:duration="280" android:valueFrom="1.3" android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:duration="280" android:valueFrom="1.3" android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="bracketPaths">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:duration="180" android:valueFrom="0" android:valueTo="1" />
        </aapt:attr>
    </target>

    <!-- 120–420 ms: the sheet appears -->
    <target android:name="sheet">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:startOffset="120" android:duration="300" android:valueFrom="0.8"
                    android:valueTo="1" android:interpolator="@android:interpolator/decelerate_cubic" />
                <objectAnimator android:propertyName="scaleY" android:startOffset="120" android:duration="300" android:valueFrom="0.8"
                    android:valueTo="1" android:interpolator="@android:interpolator/decelerate_cubic" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="paper">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:startOffset="120" android:duration="220" android:valueFrom="0" android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="fold">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:startOffset="200" android:duration="220" android:valueFrom="0" android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="shadow">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:startOffset="200" android:duration="220" android:valueFrom="0" android:valueTo="0.22" />
        </aapt:attr>
    </target>

    <!-- 380–1000 ms: the scan line sweeps down the page, then settles in the centre -->
    <target android:name="scanLine">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:startOffset="380" android:duration="120" android:valueFrom="0" android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="scan">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="translateY" android:startOffset="380" android:duration="380" android:valueFrom="-24"
                    android:valueTo="22" android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator android:propertyName="translateY" android:duration="240" android:valueFrom="22" android:valueTo="0"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
            </set>
        </aapt:attr>
    </target>
    <!-- The text lines are "read" as the line passes them -->
    <target android:name="text">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:startOffset="480" android:duration="300" android:valueFrom="0" android:valueTo="0.65" />
        </aapt:attr>
    </target>
</animated-vector>
