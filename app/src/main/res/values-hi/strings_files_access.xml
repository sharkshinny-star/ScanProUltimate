    <string name="phone_pdfs_title">इस फ़ोन की फ़ाइलें</string>
    <string name="phone_files_card_title">अपनी सभी फ़ाइलें यहाँ देखें</string>
    <string name="phone_pdfs_card_body">डाउनलोड, चैट ऐप और दूसरे फ़ोल्डर से PDF, फ़ोटो और Office फ़ाइलें ढूँढें। कुछ भी आपके फ़ोन से बाहर नहीं जाता, और यह वैकल्पिक है।</string>
    <string name="phone_pdfs_card_hide">यह कार्ड छिपाएँ</string>
