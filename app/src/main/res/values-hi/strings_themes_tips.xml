    <string name="tip_qr_body">कैमरा कोड पर रखें और उसका लिंक खोलें, टेक्स्ट कॉपी करें या संपर्क सेव करें।</string>
    <string name="tip_qr_action">कोड स्कैन करें</string>
    <string name="tip_text_title">कागज़ से टेक्स्ट कॉपी करें</string>
    <string name="tip_text_body">टेक्स्ट निकालें मोड पेज पढ़कर शब्द देता है, जिन्हें आप कॉपी, शेयर या एडिट कर सकते हैं।</string>
    <string name="tip_text_action">टेक्स्ट निकालें</string>
    <string name="tip_id_title">ID के आगे और पीछे</string>
    <string name="tip_id_body">ID कार्ड मोड कार्ड के दोनों तरफ़ एक साथ कैप्चर करता है।</string>
    <string name="tip_id_action">ID स्कैन करें</string>
    <string name="tip_book_title">किताबें साफ़-सुथरी स्कैन करें</string>
    <string name="tip_book_body">किताब मोड खुली किताबों के लिए है, और कर्व बीच में मुड़े पन्नों को सीधा करता है।</string>
    <string name="tip_book_action">किताब स्कैन करें</string>
    <string name="tip_tools_title">PDF जोड़ें, बांटें और छोटा करें</string>
    <string name="tip_tools_body">PDF टूल आपके फ़ोन की किसी भी PDF पर काम करते हैं, सिर्फ़ स्कैन पर नहीं।</string>
    <string name="tip_tools_action">PDF टूल खोलें</string>
    <string name="tip_search_title">स्कैन के अंदर खोजें</string>
    <string name="tip_search_body">हर स्कैन का टेक्स्ट पढ़ा जाता है, इसलिए आप किसी भी शब्द से पेज ढूंढ सकते हैं।</string>
    <string name="tip_search_action">खोजें</string>
    <string name="tip_backup_title">एन्क्रिप्टेड बैकअप</string>
    <string name="tip_backup_body">हर डॉक्यूमेंट का पासवर्ड के साथ बैकअप लें, आपके चुने फ़ोल्डर या क्लाउड ड्राइव में।</string>
    <string name="tip_backup_action">सेटिंग्स खोलें</string>
    <string name="tip_theme_title">पांच कलर थीम</string>
    <string name="tip_theme_body">ScanPro को ओशन, एमराल्ड, सनसेट या बेरी रंग दें, लाइट या डार्क में।</string>
    <string name="tip_theme_action">रंग चुनें</string>
    <string name="launch_tagline">स्कैन करें। खोजें। शेयर करें।</string>
