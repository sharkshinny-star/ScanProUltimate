    <string name="tools_card_pdf2text">PDF ನಿಂದ Word ಅಥವಾ ಪಠ್ಯ</string>
    <string name="tools_tile_pdf2text">PDF ನಿಂದ ಪಠ್ಯ</string>
    <string name="tools_pdf2text_title">PDF ನಿಂದ Word, Excel ಅಥವಾ ಪಠ್ಯ</string>
    <string name="tools_pdf2text_body">ಈ PDF ಅನ್ನು ಸಂಪಾದಿಸಬಹುದಾದ Word ದಾಖಲೆ, Excel ವರ್ಕ್‌ಬುಕ್ ಅಥವಾ ಸರಳ ಪಠ್ಯ ಫೈಲ್ ಆಗಿ ಬದಲಾಯಿಸುತ್ತದೆ. ಪಠ್ಯ ಇರುವ ಪುಟಗಳನ್ನು ಹಾಗೆಯೇ ನಕಲಿಸಲಾಗುತ್ತದೆ; ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಪುಟಗಳನ್ನು ಈ ಫೋನ್‌ನಲ್ಲೇ ಓದಲಾಗುತ್ತದೆ.</string>
    <string name="tools_pdf2text_format">ಹೀಗೆ ಉಳಿಸಿ</string>
    <string name="tools_pdf2text_word">Word ದಾಖಲೆ (.docx)</string>
    <string name="tools_pdf2text_plain">ಸರಳ ಪಠ್ಯ (.txt)</string>
    <string name="tools_pdf2text_unprotected_note">PDF ಗೆ ಪಾಸ್‌ವರ್ಡ್ ಇದ್ದರೂ ಫಲಿತಾಂಶಕ್ಕೆ ಪಾಸ್‌ವರ್ಡ್ ಇರುವುದಿಲ್ಲ.</string>
