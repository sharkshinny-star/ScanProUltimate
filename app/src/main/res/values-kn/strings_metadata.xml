    <string name="meta_readonly_archive">ಈ ಆರ್ಕೈವ್ ಪ್ರಕಾರದ ವಿಷಯಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡಲಾಗುವುದಿಲ್ಲ; ಅದರ ಸ್ವಂತ ವಿವರಗಳನ್ನು ತೋರಿಸಲಾಗಿದೆ.</string>
    <string name="meta_readonly_audio_format">ಈ ಧ್ವನಿ ಫಾರ್ಮ್ಯಾಟ್‌ನ ಟ್ಯಾಗ್‌ಗಳನ್ನು ಓದಬಹುದು, ಆದರೆ ಬದಲಾಯಿಸಲಾಗುವುದಿಲ್ಲ.</string>
    <string name="meta_readonly_audio_old_android">ಸಂಗೀತ ಟ್ಯಾಗ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲು Android 8 ಅಥವಾ ನಂತರದ ಆವೃತ್ತಿ ಬೇಕು. ಟ್ಯಾಗ್‌ಗಳನ್ನು ಓದಬಹುದು.</string>
    <string name="meta_readonly_format">ಈ ಬಗೆಯ ಫೈಲ್‌ನ ವಿವರಗಳನ್ನು ಓದಬಹುದು, ಆದರೆ ಇಲ್ಲಿ ಬದಲಾಯಿಸಲಾಗುವುದಿಲ್ಲ.</string>
    <string name="meta_readonly_image_format">JPEG, PNG ಮತ್ತು WebP ಚಿತ್ರಗಳನ್ನು ಮಾತ್ರ ಬದಲಾಯಿಸಬಹುದು; ಈ ಚಿತ್ರದ ವಿವರಗಳು ಓದಲು ಮಾತ್ರ.</string>
    <string name="meta_readonly_legacy_office">Word, Excel ಮತ್ತು PowerPoint 97-2003 ಫೈಲ್‌ಗಳು: ಫೈಲ್‌ನ ಸ್ವಂತ ವಿವರಗಳನ್ನು ಮಾತ್ರ ಓದಬಹುದು. ಡಾಕ್ಯುಮೆಂಟ್ ಗುಣಲಕ್ಷಣಗಳನ್ನು ನೋಡಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಅದನ್ನು DOCX, XLSX ಅಥವಾ PPTX ಆಗಿ ಉಳಿಸಿ.</string>
    <string name="meta_readonly_no_properties">ಈ ಡಾಕ್ಯುಮೆಂಟ್‌ನಲ್ಲಿ ಬರೆಯಲು ಗುಣಲಕ್ಷಣಗಳ ಭಾಗವಿಲ್ಲ, ಆದ್ದರಿಂದ ಅದರ ವಿವರಗಳು ಓದಲು ಮಾತ್ರ.</string>
    <string name="meta_readonly_pdf_locked">ಈ PDF ತೆರೆಯಲು ಪಾಸ್‌ವರ್ಡ್ ಬೇಕು, ಆದ್ದರಿಂದ ಫೈಲ್‌ನ ಸ್ವಂತ ವಿವರಗಳನ್ನು ಮಾತ್ರ ಓದಬಹುದು. ಉಳಿದವನ್ನು ನೋಡಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಮೊದಲು ಅನ್‌ಲಾಕ್ ಮಾಡಿ.</string>
    <string name="meta_readonly_raw">ಕ್ಯಾಮೆರಾ RAW ಫೈಲ್‌ಗಳು ಓದಲು ಮಾತ್ರ: ಅವುಗಳನ್ನು ಬದಲಾಯಿಸಿದರೆ ಚಿತ್ರದ ಡೇಟಾ ಹಾಳಾಗಬಹುದು.</string>
    <string name="meta_readonly_unreadable">ಈ ಫೈಲ್ ಹಾಳಾದಂತೆ ತೋರುತ್ತದೆ, ಆದ್ದರಿಂದ ಕೆಲವು ವಿವರಗಳನ್ನು ಮಾತ್ರ ಓದಲಾಯಿತು ಮತ್ತು ಯಾವುದನ್ನೂ ಬದಲಾಯಿಸಲಾಗುವುದಿಲ್ಲ.</string>
    <string name="meta_readonly_video">ವೀಡಿಯೊ ವಿವರಗಳು ಓದಲು ಮಾತ್ರ: ವೀಡಿಯೊದ ಟ್ಯಾಗ್‌ಗಳನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಮರುಬರೆಯುವುದು ಇನ್ನೂ ಬೆಂಬಲಿತವಾಗಿಲ್ಲ.</string>
