<resources>
    <string name="phone_pdfs_title">ഈ ഫോണിലെ ഫയലുകൾ</string>
    <string name="phone_files_card_title">നിങ്ങളുടെ എല്ലാ ഫയലുകളും ഇവിടെ കാണുക</string>
    <string name="phone_pdfs_card_body">ഡൗൺലോഡുകൾ, ചാറ്റ് ആപ്പുകൾ, മറ്റ് ഫോൾഡറുകൾ എന്നിവയിൽ നിന്ന് PDF, ഫോട്ടോ, Office ഫയലുകൾ കണ്ടെത്തുക. ഒന്നും നിങ്ങളുടെ ഫോണിൽ നിന്ന് പുറത്തുപോകില്ല, ഇത് ഓപ്ഷണലുമാണ്.</string>
    <string name="phone_pdfs_card_hide">ഈ കാർഡ് മറയ്ക്കുക</string>
