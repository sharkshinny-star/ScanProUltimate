<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="kept_title">സേവ് ചെയ്യാത്ത സ്കാനുകൾ</string>
    <string name="kept_intro">ഈ സ്കാനുകൾ ഡോക്യുമെന്റുകളായി സേവ് ചെയ്യാനായില്ല. വീണ്ടും ശ്രമിക്കാൻ ഇവയുടെ ഫോട്ടോകൾ 30 ദിവസം സൂക്ഷിക്കും.</string>
    <string name="kept_item_title">%1$s സ്കാൻ</string>
