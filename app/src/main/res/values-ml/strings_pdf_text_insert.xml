<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="tools_card_pdf2text">PDF ൽ നിന്ന് Word അല്ലെങ്കിൽ ടെക്സ്റ്റ്</string>
    <string name="tools_tile_pdf2text">PDF ൽ നിന്ന് ടെക്സ്റ്റ്</string>
    <string name="tools_pdf2text_title">PDF-ൽ നിന്ന് Word, Excel അല്ലെങ്കിൽ ടെക്സ്റ്റ്</string>
    <string name="tools_pdf2text_body">ഈ PDF-നെ എഡിറ്റ് ചെയ്യാവുന്ന Word പ്രമാണം, Excel വർക്ക്ബുക്ക് അല്ലെങ്കിൽ സാധാരണ ടെക്സ്റ്റ് ഫയലാക്കുന്നു. ടെക്സ്റ്റ് ഉള്ള പേജുകൾ അതേപടി പകർത്തും; സ്കാൻ ചെയ്ത പേജുകൾ ഈ ഫോണിൽ തന്നെ വായിക്കും.</string>
    <string name="tools_pdf2text_format">ഇങ്ങനെ സേവ് ചെയ്യുക</string>
    <string name="tools_pdf2text_word">Word ഡോക്യുമെന്റ് (.docx)</string>
    <string name="tools_pdf2text_plain">സാധാരണ ടെക്സ്റ്റ് (.txt)</string>
    <string name="tools_pdf2text_unprotected_note">PDF ക്ക് പാസ്‌വേഡ് ഉണ്ടെങ്കിലും ഫലത്തിന് പാസ്‌വേഡ് ഉണ്ടാകില്ല.</string>
    <string name="tools_progress_reading_text">പേജ് %1$d / %2$d വായിക്കുന്നു…</string>
    <string name="tools_progress_saving_text">ടെക്സ്റ്റ് സേവ് ചെയ്യുന്നു…</string>
    <string name="tools_text_page_heading">പേജ് %1$d</string>
    <string name="tools_text_page_empty">(ഈ പേജിൽ ടെക്സ്റ്റ് കണ്ടെത്തിയില്ല)</string>
    <string name="tools_err_pdf_text_none">ഈ PDF ൽ ടെക്സ്റ്റ് കണ്ടെത്തിയില്ല.</string>
    <string name="msg_pdf_text_reading">ടെക്സ്റ്റ് വായിക്കുന്നു…</string>
    <string name="msg_pdf_text_failed">ഈ PDF ൽ നിന്ന് ടെക്സ്റ്റ് വായിക്കാനായില്ല</string>
    <string name="msg_pdf_text_done">ടെക്സ്റ്റുള്ള പേജുകൾ: %2$d ൽ %1$d.</string>
    <string name="msg_pdf_text_ocr_pages">ടെക്സ്റ്റ് തിരിച്ചറിയൽ (OCR) വഴി വായിച്ച പേജുകൾ: %1$s.</string>
    <string name="msg_pdf_text_empty_pages">ഈ പേജുകളിൽ ടെക്സ്റ്റ് കണ്ടെത്തിയില്ല: %1$s.</string>
    <string name="msg_pdf_text_unprotected">ഫലം പാസ്‌വേഡ് ഇല്ലാതെ തുറക്കും.</string>
    <string name="tools_result_save_file_cd">ഫയൽ ഉപകരണത്തിലേക്ക് സേവ് ചെയ്യുക</string>

    <string name="tools_source_password_prompt_text">“%1$s” സംരക്ഷിതമാണ്. അതിലെ ടെക്സ്റ്റ് വായിക്കാൻ പാസ്‌വേഡ് നൽകുക.</string>
    <string name="tools_source_password_prompt_insert">“%1$s” സംരക്ഷിതമാണ്. അതിലെ പേജുകൾ ചേർക്കാൻ പാസ്‌വേഡ് നൽകുക.</string>
    <string name="tools_source_password_note_text">ടെക്സ്റ്റ് ഫയലിനോ Word ഡോക്യുമെന്റിനോ പാസ്‌വേഡ് ഉണ്ടാകില്ല.</string>
    <string name="tools_source_password_note_insert">പുതിയ PDF പാസ്‌വേഡ് ഇല്ലാതെ തുറക്കും. സംരക്ഷിക്കാൻ പിന്നീട് PDF സംരക്ഷിക്കുക ഉപയോഗിക്കുക.</string>
    <string name="tools_source_password_prompt_open">“%1$s” സംരക്ഷിച്ചതാണ്. തുറക്കാൻ അതിന്റെ പാസ്‌വേഡ് നൽകുക.</string>
    <string name="tools_source_password_note_open">ഈ ടൂൾ സേവ് ചെയ്യുന്ന ഫയൽ പാസ്‌വേഡ് ഇല്ലാതെ തുറക്കും. അത് സംരക്ഷിക്കാൻ പിന്നീട് PDF സംരക്ഷിക്കുക ടൂൾ ഉപയോഗിക്കുക.</string>

    <string name="tools_organizer_insert_pages">മറ്റൊരു PDF ൽ നിന്ന് പേജുകൾ ചേർക്കുക…</string>
    <string name="tools_insert_title">പേജുകൾ ചേർക്കുക</string>
    <string name="tools_insert_body">മറ്റൊരു PDF തിരഞ്ഞെടുക്കുക, തുടർന്ന് അതിലെ ഏതൊക്കെ പേജുകൾ എവിടെ ചേർക്കണമെന്ന് പറയുക. നിങ്ങളുടെ PDF മാറില്ല; ഫലം പുതിയ PDF ആയി സേവ് ചെയ്യും.</string>
