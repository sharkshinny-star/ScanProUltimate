    <!-- Colour themes, Home tips and the What's new sheet -->
    <string name="whats_new_title">ScanPro இல் புதியவை</string>
    <string name="whats_new_themes_title">வண்ணத் தீம்கள்</string>
    <string name="whats_new_themes_body">முழு ஆப்பிற்கும் இண்டிகோ, ஓஷன், எமரால்டு, சன்செட் அல்லது பெர்ரி நிறம், லைட் அல்லது டார்க்கில். அமைப்புகள் › தோற்றம்.</string>
    <string name="whats_new_tips_title">முகப்பில் குறிப்புகள்</string>
    <string name="whats_new_tips_body">நீங்கள் இன்னும் முயற்சிக்காத அம்சம் பற்றிய சிறு குறிப்பு. அமைப்புகளில் இவற்றை அணைக்கலாம்.</string>
    <string name="whats_new_pick_colours">உங்கள் நிறங்களைத் தேர்ந்தெடு</string>
    <string name="whats_new_got_it">சரி</string>
