    <string name="import_tip_title">கோப்புகளை இறக்குவது எப்படி?</string>
    <string name="import_tip_body">ஒரு கோப்பைத் தேர்ந்தெடுக்கத் தட்டவும், பலவற்றைத் தேர்ந்தெடுக்க நீண்ட நேரம் அழுத்தவும், பிறகு இறக்க மேலே வலதுபுறத்தில் உள்ள தேர்ந்தெடு என்பதைத் தட்டவும்.</string>
