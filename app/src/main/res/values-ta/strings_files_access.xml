<resources>
    <string name="phone_pdfs_title">இந்த ஃபோனில் உள்ள கோப்புகள்</string>
    <string name="phone_files_card_title">உங்கள் அனைத்துக் கோப்புகளையும் இங்கே பாருங்கள்</string>
    <string name="phone_pdfs_card_body">பதிவிறக்கங்கள், அரட்டை ஆப்ஸ் மற்றும் பிற கோப்புறைகளில் உள்ள PDF, படங்கள், Office கோப்புகளைக் கண்டறியுங்கள். எதுவும் உங்கள் ஃபோனை விட்டு வெளியேறாது, இது விருப்பத்திற்குரியது.</string>
    <string name="phone_pdfs_card_hide">இந்தக் கார்டை மறை</string>
    <string name="phone_files_tab_mine">எனது ஆவணங்கள்</string>
    <string name="phone_files_tab_phone">இந்த ஃபோனில்</string>
    <string name="phone_pdfs_explainer_title">உங்கள் ஃபோனில் உள்ள ஒவ்வொரு கோப்பையும் பாருங்கள்</string>
    <string name="phone_pdfs_explainer_why">உங்கள் ஃபோனில் எங்கிருந்தாலும், உதாரணமாக பதிவிறக்கங்களில் அல்லது அரட்டை ஆப்ஸில் பெற்ற கோப்புகளில் உள்ள, PDF, படங்கள், Office கோப்புகளைக் கண்டறிந்து திறக்க ScanProக்கு அனைத்துக் கோப்புகளுக்கான அணுகல் தேவை.</string>
    <string name="phone_pdfs_explainer_private">எதுவும் உங்கள் ஃபோனை விட்டு வெளியேறாது. ScanPro உங்கள் கோப்புகளைப் படிக்க மட்டுமே செய்யும்; நீங்கள் கேட்காமல் அவற்றை ஒருபோதும் மாற்றாது அல்லது நீக்காது.</string>
    <string name="phone_pdfs_explainer_optional">இது விருப்பத்திற்குரியது. ஸ்கேன் செய்தல், உங்கள் ஆவணங்கள் மற்றும் அனைத்துக் கருவிகளும் இது இல்லாமலும் இயங்கும்.</string>
    <string name="phone_pdfs_explainer_steps">அடுத்த திரையில் ScanProக்கு \"அனைத்துக் கோப்புகளையும் நிர்வகிக்க அணுகலை அனுமதி\" என்பதை இயக்கி, பிறகு திரும்பி வாருங்கள்.</string>
    <string name="phone_pdfs_explainer_steps_dialog">ScanPro உங்கள் கோப்புகளைப் படிக்கலாமா என்று Android கேட்கும்.</string>
