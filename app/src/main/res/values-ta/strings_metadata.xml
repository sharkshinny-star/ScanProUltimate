    <string name="meta_readonly_archive">இந்த ஆர்க்கைவ் வகையின் உள்ளடக்கம் பட்டியலிடப்படாது; அதன் சொந்த விவரங்கள் காட்டப்படும்.</string>
    <string name="meta_readonly_audio_format">இந்த ஒலி வடிவத்தின் டேக்குகளைப் படிக்கலாம், மாற்ற முடியாது.</string>
    <string name="meta_readonly_audio_old_android">இசை டேக்குகளை மாற்ற Android 8 அல்லது அதற்குப் பிந்தையது தேவை. டேக்குகளைப் படிக்கலாம்.</string>
    <string name="meta_readonly_format">இந்த வகைக் கோப்பின் விவரங்களைப் படிக்கலாம், ஆனால் இங்கே மாற்ற முடியாது.</string>
    <string name="meta_readonly_image_format">JPEG, PNG, WebP படங்களை மட்டுமே மாற்ற முடியும்; இந்தப் படத்தின் விவரங்கள் படிக்க மட்டும்.</string>
    <string name="meta_readonly_legacy_office">Word, Excel, PowerPoint 97-2003 கோப்புகள்: கோப்பின் சொந்த விவரங்களை மட்டுமே படிக்க முடியும். ஆவணப் பண்புகளைப் பார்க்கவும் மாற்றவும் அதை DOCX, XLSX அல்லது PPTX ஆகச் சேமிக்கவும்.</string>
    <string name="meta_readonly_no_properties">இந்த ஆவணத்தில் எழுதுவதற்கான பண்புகள் பகுதி இல்லை, அதனால் அதன் விவரங்கள் படிக்க மட்டும்.</string>
    <string name="meta_readonly_pdf_locked">இந்த PDF ஐத் திறக்கக் கடவுச்சொல் தேவை, அதனால் கோப்பின் சொந்த விவரங்களை மட்டுமே படிக்க முடியும். மற்றவற்றைப் பார்க்கவும் மாற்றவும் முதலில் அதைத் திறக்கவும்.</string>
    <string name="meta_readonly_raw">கேமரா RAW கோப்புகள் படிக்க மட்டும்: அவற்றை மாற்றினால் படத் தரவு சேதமடையலாம்.</string>
    <string name="meta_readonly_unreadable">இந்தக் கோப்பு சேதமடைந்ததுபோல் தெரிகிறது, அதனால் சில விவரங்களை மட்டுமே படிக்க முடிந்தது; எதையும் மாற்ற முடியாது.</string>
    <string name="meta_readonly_video">வீடியோ விவரங்கள் படிக்க மட்டும்: வீடியோவின் டேக்குகளைப் பாதுகாப்பாக மாற்றும் வசதி இன்னும் இல்லை.</string>
