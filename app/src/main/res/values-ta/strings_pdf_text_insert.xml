<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="tools_card_pdf2text">PDF இலிருந்து Word அல்லது உரை</string>
    <string name="tools_tile_pdf2text">PDF இலிருந்து உரை</string>
    <string name="tools_pdf2text_title">PDF-இலிருந்து Word, Excel அல்லது உரை</string>
    <string name="tools_pdf2text_body">இந்த PDF-ஐ திருத்தக்கூடிய Word ஆவணம், Excel பணிப்புத்தகம் அல்லது வெற்று உரைக் கோப்பாக மாற்றுகிறது. உரை உள்ள பக்கங்கள் அப்படியே நகலெடுக்கப்படும்; ஸ்கேன் செய்த பக்கங்கள் இந்த போனிலேயே படிக்கப்படும்.</string>
    <string name="tools_pdf2text_format">இவ்வாறு சேமி</string>
    <string name="tools_pdf2text_word">Word ஆவணம் (.docx)</string>
    <string name="tools_pdf2text_plain">எளிய உரை (.txt)</string>
    <string name="tools_pdf2text_unprotected_note">PDF க்கு கடவுச்சொல் இருந்தாலும் முடிவுக்கு கடவுச்சொல் இருக்காது.</string>
    <string name="tools_progress_reading_text">பக்கம் %1$d / %2$d படிக்கப்படுகிறது…</string>
    <string name="tools_progress_saving_text">உரை சேமிக்கப்படுகிறது…</string>
    <string name="tools_text_page_heading">பக்கம் %1$d</string>
    <string name="tools_text_page_empty">(இந்தப் பக்கத்தில் உரை கிடைக்கவில்லை)</string>
    <string name="tools_err_pdf_text_none">இந்த PDF இல் உரை கிடைக்கவில்லை.</string>
    <string name="msg_pdf_text_reading">உரை படிக்கப்படுகிறது…</string>
    <string name="msg_pdf_text_failed">இந்த PDF இலிருந்து உரையைப் படிக்க முடியவில்லை</string>
    <string name="msg_pdf_text_done">உரை உள்ள பக்கங்கள்: %2$d இல் %1$d.</string>
    <string name="msg_pdf_text_ocr_pages">உரை அடையாளம் காணுதல் (OCR) மூலம் படித்த பக்கங்கள்: %1$s.</string>
    <string name="msg_pdf_text_empty_pages">இந்தப் பக்கங்களில் உரை கிடைக்கவில்லை: %1$s.</string>
    <string name="msg_pdf_text_unprotected">முடிவு கடவுச்சொல் இல்லாமல் திறக்கும்.</string>
    <string name="tools_result_save_file_cd">கோப்பை சாதனத்தில் சேமி</string>

    <string name="tools_source_password_prompt_text">“%1$s” பாதுகாக்கப்பட்டுள்ளது. அதன் உரையைப் படிக்க கடவுச்சொல்லை உள்ளிடவும்.</string>
    <string name="tools_source_password_prompt_insert">“%1$s” பாதுகாக்கப்பட்டுள்ளது. அதன் பக்கங்களைச் சேர்க்க கடவுச்சொல்லை உள்ளிடவும்.</string>
    <string name="tools_source_password_note_text">உரைக் கோப்பு அல்லது Word ஆவணத்துக்கு கடவுச்சொல் இருக்காது.</string>
    <string name="tools_source_password_note_insert">புதிய PDF கடவுச்சொல் இல்லாமல் திறக்கும். அதைப் பாதுகாக்க பின்னர் PDF ஐப் பாதுகாக்கவும் என்பதைப் பயன்படுத்தவும்.</string>
    <string name="tools_source_password_prompt_open">“%1$s” பாதுகாக்கப்பட்டுள்ளது. திறக்க அதன் பாஸ்வேர்டை உள்ளிடுங்கள்.</string>
    <string name="tools_source_password_note_open">இந்தக் கருவி சேமிக்கும் கோப்பு பாஸ்வேர்டு இல்லாமல் திறக்கும். அதைப் பாதுகாக்க, பிறகு PDF பாதுகாப்பு கருவியைப் பயன்படுத்துங்கள்.</string>

    <string name="tools_organizer_insert_pages">மற்றொரு PDF இலிருந்து பக்கங்களைச் சேர்…</string>
    <string name="tools_insert_title">பக்கங்களைச் சேர்</string>
    <string name="tools_insert_body">மற்றொரு PDF ஐத் தேர்ந்தெடுத்து, அதன் எந்தப் பக்கங்களை எங்கே சேர்க்க வேண்டும் எனச் சொல்லுங்கள். உங்கள் PDF மாறாது; முடிவு புதிய PDF ஆகச் சேமிக்கப்படும்.</string>
    <string name="tools_insert_choose_pdf">PDF ஐத் தேர்ந்தெடு</string>
    <string name="tools_insert_which_pages">சேர்க்க வேண்டிய பக்கங்கள்</string>
    <string name="tools_insert_all_pages">அனைத்துப் பக்கங்களும்</string>
    <string name="tools_insert_page_range">சில பக்கங்கள்</string>
    <string name="tools_insert_range_label">பக்கங்கள், எ.கா. 1-3, 5</string>
    <string name="tools_insert_where">எங்கே வைப்பது</string>
    <string name="tools_insert_at_start">தொடக்கத்தில்</string>
    <string name="tools_insert_after_page">ஒரு பக்கத்துக்குப் பிறகு</string>
    <string name="tools_insert_after_label">பக்கத்துக்குப் பிறகு (1 முதல் %1$d வரை)</string>
    <string name="tools_insert_at_end">இறுதியில்</string>
    <string name="tools_insert_action">சேர்</string>
    <string name="tools_err_insert_duplicate">ஒரு பக்கம் இரண்டு முறை குறிப்பிடப்பட்டுள்ளது. ஒவ்வொரு பக்கத்தையும் ஒருமுறை மட்டும் குறிப்பிடவும்.</string>
    <string name="tools_err_insert_position">அந்த இடம் PDF இல் இல்லை.</string>
    <string name="tools_err_insert_unreadable">இரண்டாவது PDF ஐப் படிக்க முடியவில்லை. அது சேதமடைந்திருக்கலாம்.</string>
    <string name="tools_result_insert_unprotected">புதிய PDF கடவுச்சொல் இல்லாமல் திறக்கும்.</string>
    <string name="msg_tools_inserting_pages">பக்கங்கள் சேர்க்கப்படுகின்றன…</string>
    <string name="msg_tools_insert_failed">பக்கங்களைச் சேர்க்க முடியவில்லை</string>
