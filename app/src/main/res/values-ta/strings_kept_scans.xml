<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="kept_title">சேமிக்கப்படாத ஸ்கேன்கள்</string>
    <string name="kept_intro">இந்த ஸ்கேன்களை ஆவணங்களாகச் சேமிக்க முடியவில்லை. மீண்டும் முயல அவற்றின் ஃபோட்டோக்கள் 30 நாட்கள் வைக்கப்படும்.</string>
    <string name="kept_item_title">%1$s ஸ்கேன்</string>
    <plurals name="kept_item_meta">
        <item quantity="one">%1$d ஃபோட்டோ · %2$s</item>
        <item quantity="other">%1$d ஃபோட்டோக்கள் · %2$s</item>
    </plurals>
    <string name="kept_item_expires">%1$s வரை வைக்கப்படும்</string>
