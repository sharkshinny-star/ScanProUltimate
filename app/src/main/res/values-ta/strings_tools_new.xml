    <string name="tools_card_redact">உரையை மறை</string>
    <string name="tools_tile_redact">மறை</string>
    <string name="tools_desc_redact">சொற்களை நிரந்தரமாகக் கறுப்பாக்கு</string>
    <string name="hint_tool_redact">பெயர்கள், எண்கள் அல்லது எந்தச் சொற்களையும் எங்கு இருந்தாலும் கறுப்பாக்குங்கள். பொருந்திய பக்கங்கள் படங்களாகின்றன, எனவே சொற்கள் உண்மையிலேயே நீங்கும், மூடப்படுவதில்லை.</string>
    <string name="tools_redact_body">ஒவ்வொரு பொருத்தமும் கறுப்பாக வரையப்பட்டு, பொருத்தம் உள்ள ஒவ்வொரு பக்கமும் படமாக மீண்டும் வரையப்படுகிறது, எனவே உரையை மீட்க முடியாது. பொருத்தம் இல்லாத பக்கங்கள் தங்கள் உரையை வைத்திருக்கும். உரை மீண்டும் வேண்டுமெனில் பிறகு “தேடக்கூடியதாக்கு”-ஐப் பயன்படுத்தவும்.</string>
    <string name="tools_redact_terms_label">கறுப்பாக்க வேண்டிய சொற்கள்</string>
    <string name="tools_redact_terms_hint">வரிக்கு ஒன்று, அல்லது காற்புள்ளியால் பிரித்து</string>
    <string name="tools_redact_match_case">பெரிய, சிறிய எழுத்துகளைப் பொருத்து</string>
    <plurals name="tools_redact_terms_count">
