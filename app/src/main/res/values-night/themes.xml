<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark system theme: without these the window behind the first frame flashes light. -->
    <style name="Theme.ScanPro" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowBackground">@color/scanpro_window_dark</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/scanpro_window_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_splash</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">1000</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/scanpro_brand</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

</resources>
