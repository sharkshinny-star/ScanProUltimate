<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark system theme: without these the window behind the first frame flashes light. -->
    <style name="Theme.ScanPro" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.ScanPro.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F172A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_scanpro</item>
        <item name="windowSplashScreenIconBackgroundColor">#1E1B4B</item>
        <item name="postSplashScreenTheme">@style/Theme.ScanPro</item>
    </style>
</resources>
