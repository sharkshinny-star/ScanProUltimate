    <string name="tools_info_progress">Reading PDF details…</string>
    <string name="tools_info_err_failed">Couldn\'t read this PDF\'s details.</string>
    <string name="tools_info_pages">Pages</string>
    <string name="tools_info_version">PDF version</string>
    <string name="tools_info_size">File size</string>
