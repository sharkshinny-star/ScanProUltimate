    <string name="tools_info_field_title">Title</string>
    <string name="tools_info_field_author">Author</string>
    <string name="tools_info_field_subject">Subject</string>
    <string name="tools_info_field_keywords">Keywords</string>
    <string name="tools_info_save">Save copy</string>
    <string name="tools_info_remove_all">Remove all metadata</string>
    <string name="tools_info_remove_all_hint">For privacy: removes the title, author, apps, dates and other hidden details, in a new copy.</string>
    <string name="tools_info_xmp_note">This PDF also keeps a second (XMP) copy of its details. It is removed when you save, so every reader shows the same details.</string>
    <string name="tools_info_saving">Saving details…</string>
    <string name="tools_info_save_failed">Couldn\'t save the new details.</string>
    <string name="tools_info_saved">Details updated</string>
    <string name="tools_info_removed">All metadata removed</string>

    <!-- First-use introductions of the new tools. -->
    <string name="hint_tool_blank_pages">Find the empty pages in a scanned PDF and remove them, after you check the list.</string>
    <string name="hint_tool_greyscale">Turn a colour PDF into shades of grey, for cheaper printing or a smaller file.</string>
    <string name="hint_tool_flatten">Draw form answers, comments and stamps into the pages so nobody can change them.</string>
    <string name="hint_tool_extract_images">Save every picture inside a PDF as its own image file.</string>
    <string name="hint_tool_pdf_info">See a PDF\'s hidden details, edit the title or author, or remove them all for privacy.</string>
    <!-- Crop PDF pages and Redact text (F172). -->
    <string name="tools_card_crop_pdf">Crop PDF pages</string>
    <string name="tools_tile_crop_pdf">Crop pages</string>
    <string name="tools_desc_crop_pdf">Trim margins or white space</string>
    <string name="hint_tool_crop_pdf">Trim the margins of every page, automatically around the content or by the millimetre. The text layer is kept.</string>
    <string name="tools_crop_pdf_body">Auto trims each page to its content with a little padding; Margins cuts the amount you set from every page as it is shown. Nothing is deleted, so the pages can be uncropped later with Repair.</string>
    <string name="tools_crop_pdf_mode_auto">Auto trim</string>
    <string name="tools_crop_pdf_mode_margins">Margins</string>
    <string name="tools_crop_pdf_padding">Padding around content</string>
    <string name="tools_crop_pdf_top">Top</string>
    <string name="tools_crop_pdf_bottom">Bottom</string>
    <string name="tools_crop_pdf_left">Left</string>
    <string name="tools_crop_pdf_right">Right</string>
    <string name="tools_crop_pdf_mm">%1$d mm</string>
    <string name="tools_crop_pdf_action">Crop pages</string>
    <string name="tools_crop_pdf_progress">Cropping pages…</string>
    <string name="tools_crop_pdf_err_failed">Couldn\'t crop this PDF.</string>
    <string name="tools_crop_pdf_err_nothing">Nothing to crop: every page is already as tight as it can be, or the crop would leave too little of it.</string>
    <plurals name="tools_crop_pdf_done">
        <item quantity="one">Cropped %1$d page</item>
        <item quantity="other">Cropped %1$d pages</item>
    </plurals>

    <string name="tools_card_redact">Redact text</string>
    <string name="tools_tile_redact">Redact</string>
    <string name="tools_desc_redact">Black out words for good</string>
    <string name="hint_tool_redact">Black out names, numbers or any words wherever they appear. Pages with a match become pictures, so the words are really gone, not just covered.</string>
    <string name="tools_redact_body">Every match is painted black and each page with a match is redrawn as a picture, so the text cannot be recovered. Pages without a match keep their text. Use Make searchable afterwards if you need the text back.</string>
    <string name="tools_redact_terms_label">Words to black out</string>
    <string name="tools_redact_terms_hint">One per line, or separated by commas</string>
    <string name="tools_redact_match_case">Match upper and lower case</string>
    <plurals name="tools_redact_terms_count">
        <item quantity="one">%1$d word will be searched for</item>
        <item quantity="other">%1$d words will be searched for</item>
    </plurals>
    <string name="tools_redact_action">Redact</string>
    <string name="tools_redact_progress">Redacting…</string>
    <string name="tools_redact_progress_searching">Searching for the words…</string>
    <string name="tools_redact_err_failed">Couldn\'t redact this PDF.</string>
    <string name="tools_redact_err_no_matches">None of those words were found in this PDF\'s text. A scanned page needs Make searchable first.</string>
    <string name="tools_redact_done" tools:ignore="PluralsCandidate">Blacked out %1$d matches on %2$d pages</string>
    <!-- N-up and Header and footer (F173). -->
    <string name="tools_card_nup">Pages per sheet (N-up)</string>
    <string name="tools_tile_nup">N-up</string>
    <string name="tools_desc_nup">Put 2 or 4 pages on one sheet</string>
    <string name="hint_tool_nup">Put two or four pages on each sheet, in reading order, for printing drafts, slides or handouts.</string>
    <string name="tools_nup_body">Pages are scaled down and placed side by side, in reading order. Text and pictures stay sharp: nothing is redrawn, only moved and shrunk.</string>
    <string name="tools_nup_two">2 per sheet</string>
    <string name="tools_nup_four">4 per sheet</string>
    <string name="tools_nup_action">Make sheets</string>
    <string name="tools_nup_progress">Laying out the sheets…</string>
    <string name="tools_nup_err_failed">Couldn\'t lay out this PDF.</string>
    <string name="tools_nup_err_one_page">This PDF has only one page, so there is nothing to put side by side.</string>
    <string name="tools_nup_done" tools:ignore="PluralsCandidate">Placed %1$d pages on %2$d sheets</string>

    <string name="tools_card_header_footer">Header and footer</string>
    <string name="tools_tile_header_footer">Header/footer</string>
    <string name="tools_desc_header_footer">Text along the top or bottom</string>
    <string name="hint_tool_header_footer">Put a line of text along the top or bottom of every page: a title, a date, a file reference.</string>
    <string name="tools_hf_body">The text is added to each page as it is shown; everything else stays untouched. Write {page} or {total} to show the page number or the page count.</string>
    <string name="tools_hf_header_label">Header (top of the page)</string>
    <string name="tools_hf_footer_label">Footer (bottom of the page)</string>
    <string name="tools_hf_placeholders_hint">{page} becomes the page number, {total} the page count.</string>
    <string name="tools_hf_align_left">Left</string>
    <string name="tools_hf_align_centre">Centre</string>
    <string name="tools_hf_align_right">Right</string>
    <string name="tools_hf_skip_first">Skip the first page</string>
    <string name="tools_hf_action">Add text</string>
    <string name="tools_hf_progress">Adding the text…</string>
    <string name="tools_hf_err_failed">Couldn\'t add the header or footer.</string>
    <plurals name="tools_hf_done">
        <item quantity="one">Added the text to %1$d page</item>
        <item quantity="other">Added the text to %1$d pages</item>
    </plurals>
