<resources>
    <string name="phone_pdfs_title">Files on this phone</string>
    <string name="phone_files_card_title">See all your files here</string>
    <string name="phone_pdfs_card_body">Find PDFs, photos and Office files from Downloads, chat apps and other folders. Nothing leaves your phone, and it\'s optional.</string>
    <string name="phone_pdfs_card_hide">Hide this card</string>
    <string name="phone_files_tab_mine">My documents</string>
    <string name="phone_files_tab_phone">On this phone</string>
    <string name="phone_pdfs_explainer_title">See every file on your phone</string>
    <string name="phone_pdfs_explainer_why">ScanPro needs All files access to find and open PDFs, photos and Office files anywhere on your phone, such as Downloads or files you received in chat apps.</string>
    <string name="phone_pdfs_explainer_private">Nothing leaves your phone. ScanPro only reads your files and never changes or deletes them unless you ask it to.</string>
    <string name="phone_pdfs_explainer_optional">This is optional. Scanning, your documents and every tool work without it.</string>
    <string name="phone_pdfs_explainer_steps">On the next screen, turn on \"Allow access to manage all files\" for ScanPro, then come back.</string>
    <string name="phone_pdfs_explainer_steps_dialog">Android will ask whether ScanPro may read your files.</string>
    <string name="phone_pdfs_allow">Allow access</string>
    <string name="phone_pdfs_not_now">Not now</string>
    <string name="phone_pdfs_settings_failed">Couldn\'t open the settings page. Allow All files access for ScanPro in Settings &gt; Apps.</string>
