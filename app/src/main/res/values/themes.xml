<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ScanPro" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FEF7FF</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#FEF7FF</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">#FEF7FF</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Shown by the system while the app starts, then swapped for Theme.ScanPro (see installSplashScreen). -->
    <style name="Theme.ScanPro.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8FAFC</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_scanpro</item>
        <item name="windowSplashScreenIconBackgroundColor">#0F172A</item>
        <item name="postSplashScreenTheme">@style/Theme.ScanPro</item>
    </style>
</resources>
