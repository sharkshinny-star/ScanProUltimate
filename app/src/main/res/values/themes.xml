<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Edge to edge: both bars are transparent and the app draws behind them; Compose pads its own content. -->
    <style name="Theme.ScanPro" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowBackground">@color/scanpro_window_light</item>
        <!-- Android 12+ launch screen: the first frame of the launch animation (ui/LaunchIntro.kt) on the app background. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/scanpro_window_light</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_splash</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">1000</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/scanpro_splash_icon_bg</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Home-screen widget (R33) -->
    <style name="ScanProWidgetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/widget_button_background</item>
    </style>
    <style name="ScanProWidgetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/scanpro_widget_text</item>
    </style>
</resources>
