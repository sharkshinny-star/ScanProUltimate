    <string name="settings_palette_subtitle">ScanPro రంగులు ఎంచుకోండి</string>
    <string name="settings_palette_subtitle_wallpaper">వాల్‌పేపర్ రంగులు ఆన్‌లో ఉన్నాయి. బదులుగా థీమ్ వాడాలంటే దాన్ని ఎంచుకోండి.</string>
    <string name="settings_home_tips_title">హోమ్‌లో చిట్కాలు</string>
    <string name="settings_home_tips_subtitle">మీరు ఇంకా ప్రయత్నించని ఫీచర్ గురించి చిన్న చిట్కా</string>
    <string name="tip_eyebrow">మీకు తెలుసా?</string>
