.gradle/
.idea/*
# Shared IDE settings: the inspection profile and scopes that keep generated OpenCV code out of inspections,
# and the project dictionary.
!.idea/inspectionProfiles/
!.idea/scopes/
!.idea/dictionaries/
local.properties
build/
*/build/
*.iml
.DS_Store
.kotlin/

# IDE "Inspect Code" exports (keep them outside the repo) and Firebase config (the app is offline-first; never commit it)
/index.html
/script.js
/styles.css
/.descriptions.xml
/[A-Z]*.xml
google-services.json

# Release signing material must never be committed (see app/build.gradle.kts for how it is supplied).
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties

# Scratch and analysis artifacts
tmp/
.scratch/
__pycache__/
*.pyc

